# Copy to .env for local use (never commit .env). On Render, set these in the dashboard instead.

GEMINI_API_KEY=
# Models are tried in order; if one is busy or retired the next is used
GEMINI_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.5-flash-lite

# Signs assistant replies so visitors cannot forge chat history. Any long random string.
HISTORY_SECRET=

# Browsers allowed to call this API (comma separated)
ALLOWED_ORIGINS=https://qenbel.site,https://www.qenbel.site,http://127.0.0.1:4173,http://localhost:4173

# Reverse proxies in front of the app (0 when running locally with nothing in front)
TRUST_PROXY=0

# The only address the assistant may repeat in a reply
TEAM_EMAIL=admin.qenbel@gmail.com
